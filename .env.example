# Public values from Supabase: Project Settings -> API Keys.
# The publishable key is safe in the browser: access is enforced by RLS in the database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Only for `npm run security-check` on your machine. Same password for all test users.
TEST_USERS_PASSWORD=
